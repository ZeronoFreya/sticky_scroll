.ss_sticky-containter(:ref="setRef('root')", :class="[theme ? 'ss_' + theme : 'ss_default']",
    :style="{minWidth: minW, minHeight: minH, maxWidth: maxW, maxHeight: maxH}",
)
    .ss_scroll_box.ss_sticky_hide_default_scrollbar(
        :ref="setRef('scroll_box')", 
        @scroll="mousescroll",
        :style="{borderRadius: radius, overflowX: scrollCfg.showX ? 'auto' : 'hidden', overflowY: scrollCfg.showY ? 'auto' : 'hidden'}"
    )
        .ss_sticky_anchor(:ref="setRef('sticky_anchor')")
            .ss_scroll_content(:ref="setRef('scroll_content')", :class="{ss_scroll_x: scroll == 'x'}")
                slot
                template(v-if="scrollCfg.showX && overscrollX")
                    .ss_overscroll_before_x(
                        data-scroll="x", 
                        :class="{ss_overscroll_show: overscrollStateX}",
                        :ref="setRef('overscroll.before_x')", 
                        @mouseenter="mouseenter", @mouseleave="mouseleave"
                    )
                        slot(name="before_x")
                            span.ss_overscroll_sticky_before_x 没了
                    .ss_overscroll_after_x(
                        data-scroll="x", 
                        :class="{ss_overscroll_show: overscrollStateX}",
                        :ref="setRef('overscroll.after_x')",
                        @mouseenter="mouseenter", @mouseleave="mouseleave"
                    )
                        slot(name="after_x")
                            span.ss_overscroll_sticky_after_x 没了
                template(v-if="scrollCfg.showY && overscrollY")
                    .ss_overscroll_before_y(
                        data-scroll="y", 
                        :class="{ss_overscroll_show: overscrollStateY}",
                        :ref="setRef('overscroll.before_y')",
                        @mouseenter="mouseenter", @mouseleave="mouseleave"
                    )
                        slot(name="before_y")
                            span.ss_overscroll_sticky_before_y 到顶了
                    .ss_overscroll_after_y(
                        v-show="!loading.y.status",
                        data-scroll="y", 
                        :class="{ss_overscroll_show: overscrollStateY}",
                        :ref="setRef('overscroll.after_y')",
                        @mouseenter="mouseenter", @mouseleave="mouseleave"
                    )
                        slot(name="after_y")  
                            span.ss_overscroll_sticky_after_y  到底了    
                .ss_overscroll_load_x(
                    v-if="loading.x.status"
                    data-scroll="x", 
                    :class="{ss_overscroll_show: overscrollStateX}",
                    :ref="setRef('overscroll.load_x')",
                )
                    slot(name="load_x")  
                        span.ss_overscroll_sticky_load_x  加载中
                .ss_overscroll_load_y(
                    v-show="loading.y.status"
                    data-scroll="y", 
                    :class="{ss_overscroll_show: overscrollStateY}",
                    :ref="setRef('overscroll.load_y')",
                )
                    slot(name="load_y")  
                        span.ss_overscroll_sticky_load_y  加载中                
        .ss_spacer(v-if="scrollCfg.showX", :ref="setRef('spacer_x')")
        .ss_spacer(v-if="scrollCfg.showY || scroll == 'x'", :ref="setRef('spacer_y')")
    Teleport(:to="teleportX", defer, :disabled="disTeleport.x")
        .ss_sticky_scroll.ss_sticky_scroll_x(
            v-if="!customScrollBar && scrollCfg.showX", 
            :ref="setRef('scrollbar.scroll_x')",
            :class="{ss_sticky_scroll_hide: scrollStateX}",
            :style="scrollCfg.styleX"
        )
            .ss_track_x(:ref="setRef('scrollbar.track_x')", data-scroll="x", @pointerdown.stop="track_down")
                .ss_track_view.ss_track_view_x
                .ss_thumb_x(:ref="setRef('scrollbar.thumb_x')")
                    .ss_thumb_view.ss_thumb_view_x
    Teleport(:to="teleportY", defer, :disabled="disTeleport.y")
        .ss_sticky_scroll.ss_sticky_scroll_y(
            v-if="!customScrollBar && scrollCfg.showY", 
            :ref="setRef('scrollbar.scroll_y')",
            :class="{ss_sticky_scroll_hide: scrollStateY}",
            :style="scrollCfg.styleY"
        )
            .ss_track_y(:ref="setRef('scrollbar.track_y')", data-scroll="y", @pointerdown.stop="track_down")
                .ss_track_view.ss_track_view_y
                .ss_thumb_y(:ref="setRef('scrollbar.thumb_y')")
                    .ss_thumb_view.ss_thumb_view_y